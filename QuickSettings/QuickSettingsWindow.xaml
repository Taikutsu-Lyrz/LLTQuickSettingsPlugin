<wpfui:UiWindow
    x:Class="LenovoLegionToolkit.Plugin.QuickSettings.QuickSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:quick="clr-namespace:LenovoLegionToolkit.Plugin.QuickSettings"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="400"
    MinWidth="0"
    SizeToContent="Height"
    WindowStartupLocation="Manual"
    WindowBackdropType="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent">
    <Border
        Margin="8"
        Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="8">
        <quick:QuickSettingsContentControl />
    </Border>
</wpfui:UiWindow>

