<wpfui:UiPage x:Class="LenovoLegionToolkit.Plugin.QuickSettings.MiniLayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LenovoLegionToolkit.Plugin.QuickSettings" xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Mini Layout" Scrollable="False" SizeChanged="Page_SizeChanged">
    <Grid Margin="24,14,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Mini Layout" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Arrange the controls shown in Quick settings." Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="18" Margin="0,0,0,16" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Quick settings shortcut" FontSize="18" FontWeight="SemiBold"/>
                    <wpfui:ToggleSwitch x:Name="_enabled" Grid.Column="1" Click="Enabled_Click" ToolTip="Enable the global shortcut"/>
                </Grid>
                <TextBlock Text="Select the shortcut field and press a new key combination." Margin="0,4,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="_shortcut" Width="240" IsReadOnly="True" PreviewKeyDown="Shortcut_KeyDown" ToolTip="Use Ctrl, Alt, Shift or Win with a key"/>
                    <wpfui:Button Content="Apply" Margin="8,0,0,0" Click="ApplyHotkey_Click"/>
                    <wpfui:Button Content="Reset shortcut" Margin="8,0,0,0" Click="ResetHotkey_Click"/>
                </StackPanel>
                <TextBlock x:Name="_warning" Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <Grid x:Name="_workspace" Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="460"/></Grid.ColumnDefinitions>
            <Border x:Name="_itemsCard" Padding="18" Margin="0,0,10,0" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16"><TextBlock Text="Build your flyout" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Click to show or hide. Drag to reorder each section." Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="_items"/></ScrollViewer>
                    <wpfui:Button Grid.Row="2" Content="Reset to default" Icon="ArrowCounterclockwise24" HorizontalAlignment="Right" Margin="0,12,0,0" Click="ResetLayout_Click"/>
                </Grid>
            </Border>
            <Border x:Name="_previewCard" Grid.Column="1" Padding="18" Margin="10,0,0,0" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16"><TextBlock Text="Quick settings preview" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Your changes appear here." Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <Border Grid.Row="1" CornerRadius="14" BorderThickness="1" Padding="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}">
                        <local:QuickSettingsContentControl x:Name="_preview" Width="400" HorizontalAlignment="Center" IsPreview="True" Focusable="False" SizeChanged="Preview_SizeChanged"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</wpfui:UiPage>
